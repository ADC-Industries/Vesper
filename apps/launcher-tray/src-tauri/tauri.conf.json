{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesper Launcher",
  "mainBinaryName": "vesper-launcher-tray",
  "version": "0.1.1",
  "identifier": "org.vesper.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vesper Launcher",
        "url": "index.html",
        "width": 440,
        "height": 640,
        "minWidth": 380,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Installs, updates and monitors Vesper on this machine",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Vesper",
    "copyright": "Copyright (c) 2026 ADC Industries",
    "license": "MIT OR Apache-2.0",
    "longDescription": "The Vesper Launcher's tray icon and window: the Vesper products on this machine (running, stopped, update available) with Launch, Stop, Update and Logs, and the first-run setup (roles, joining the site). It talks only to the Vesper Launcher service on this machine.",
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}
