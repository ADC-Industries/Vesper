# Vesper on a display box: the same server as vesper.service, which also shows screens full
# screen on the monitors and projectors attached to this box (HDMI / DisplayPort). It drives
# them directly (kernel mode setting): no desktop, compositor or auto-login is needed, but no
# desktop session may run on the same graphics card (the server must be its DRM master).
#
# Use one or the other:
#   sudo systemctl disable --now vesper && sudo systemctl enable --now vesper-display
#
# Settings: /etc/default/vesper (VESPER_ARGS), shared with vesper.service.
# Data: /var/lib/vesper. Logs: journalctl -u vesper-display.
[Unit]
Description=Vesper presentation server with display outputs
Documentation=file:///usr/share/doc/vesper/PACKAGING.md
Wants=network-online.target avahi-daemon.service
After=network-online.target avahi-daemon.service sound.target
# The boot splash holds the displays while it runs: start after it.
After=plymouth-quit-wait.service systemd-user-sessions.service
Conflicts=vesper.service

[Service]
Type=exec
User=vesper
Group=vesper
# GPU (render, video: /dev/dri, including the card node it drives the displays through) and
# sound cards (audio: /dev/snd).
SupplementaryGroups=render video audio
EnvironmentFile=-/etc/default/vesper
Environment=HOME=/var/lib/vesper XDG_CACHE_HOME=/var/cache/vesper
ExecStart=/usr/bin/vesper --data /var/lib/vesper --ui-dir /usr/share/vesper/ui $VESPER_ARGS
WorkingDirectory=/var/lib/vesper
StateDirectory=vesper
StateDirectoryMode=0750
CacheDirectory=vesper
Restart=on-failure
RestartSec=3
# The server stops cleanly on SIGTERM (outputs, Site Manager, mDNS).
TimeoutStopSec=20
LimitNOFILE=65536

# Hardening. Writable: /var/lib/vesper, /var/cache/vesper and a private /tmp only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# Devices: the GPU (DRM render nodes for wgpu and VA-API, the card node for the displays) and
# ALSA sound cards only.
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-alsa rw
# IP for the API, IDN and mDNS; netlink to list the network interfaces; Unix sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Not set on purpose: MemoryDenyWriteExecute (the GPU drivers' shader compilers JIT code),
# PrivateDevices (hides /dev/dri and /dev/snd), RestrictRealtime (audio threads may ask for
# real-time priority), PrivateNetwork/IPAddressDeny (it is a network server).

[Install]
WantedBy=multi-user.target
